  "rank_transport": {
    "conclusion": "rank_F7(N M N^T)=rank_F7(M)",
    "field": "F_7",
    "frozen_identities": [
      "N M N^T=J-I-2A (mod 7)",
      "N^T N M=3M (mod 7)"
