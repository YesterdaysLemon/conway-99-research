{
  "border_rank_lemma": {
    "W_restrictions_used": "none",
    "proof": "A congruence splits S into an invertible rank(S) block and its radical. Eliminating the border against the invertible block leaves [[0,Q],[Q^T,W']], Q=H^T U. Its kernel has dimension at most (rows(Q)-rank(Q))+(cols(Q)-rank(Q)), so its rank is at least 2*rank(Q).",
    "statement": "For symmetric S and arbitrary U,W, rank([[S,U],[U^T,W]]) >= rank(S)+2*rank(H^T U), where the columns of H are a basis of ker(S)."
  },
  "claim_label": "VERIFIED",
  "endpoint_arithmetic": {
    "if_r3_equals_12": "r7 is even and at least 26",
    "inherited_ranges": "12<=r3<=44 and 25<=r7<=44",
    "parity": "r3+r7 is even",
    "remaining_rank_pairs": 330
  },
  "format": "wave40-exact-coupling-independent-v1",
